<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Hebrew text "קבלה" as vector paths (RTL → displayed L→R: ה ל ב ק)
        Safe zone: x=21–87, y=21–87. Letters at y=40–68, x=23–85.
        Each letter: ~14w × 28h, stroke ~2.5, gap 2.
    -->

    <!-- ה (He) — top bar + left leg + right stub (not connected to top) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M23,40 L37,40 L37,42.5 L23,42.5 Z
                          M23,40 L25.5,40 L25.5,68 L23,68 Z
                          M34.5,53 L37,53 L37,68 L34.5,68 Z"/>

    <!-- ל (Lamed) — curved top going right, long left descender -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,40 L53,40 L53,42.5 L39,42.5 Z
                          M50.5,40 L53,40 L53,51 L50.5,51 Z
                          M39,49 L41.5,49 L41.5,68 L39,68 Z"/>

    <!-- ב (Bet) — left vertical + top bar + bottom bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,40 L69,40 L69,42.5 L55,42.5 Z
                          M55,40 L57.5,40 L57.5,68 L55,68 Z
                          M55,65.5 L69,65.5 L69,68 L55,68 Z"/>

    <!-- ק (Kof) — left vertical + top bar + right stub (descends past baseline) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M71,40 L85,40 L85,42.5 L71,42.5 Z
                          M71,40 L73.5,40 L73.5,68 L71,68 Z
                          M82.5,40 L85,40 L85,62 L82.5,62 Z"/>

</vector>
